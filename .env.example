# ─── Serveur ───────────────────────────────────────────────────────────────────
PORT=3000
# URL publique de l'application, utilisée pour construire les redirect URI OAuth.
APP_BASE_URL=http://localhost:3000
DATABASE_PATH=./data/familyboard.db

# Fuseau horaire par défaut du foyer (IANA). Sert au calcul des rappels.
DEFAULT_TIMEZONE=Europe/Paris
# Heure locale d'envoi des rappels J-7, J-1 et jour J (0-23).
REMINDER_HOUR=8

# ─── Planificateur ─────────────────────────────────────────────────────────────
# Intervalle de vérification des rappels à envoyer (ms).
SCHEDULER_INTERVAL_MS=60000
# Intervalle de synchronisation automatique des agendas liés (ms). 0 = désactivé.
SYNC_INTERVAL_MS=900000

# ─── Google Calendar (compte perso) ────────────────────────────────────────────
# Console Google Cloud > API & Services > Identifiants > ID client OAuth (Web).
# Redirect URI à déclarer : {APP_BASE_URL}/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Microsoft Graph / Outlook (compte pro) ────────────────────────────────────
# Portail Azure > Inscriptions d'applications. Redirect URI (Web) à déclarer :
# {APP_BASE_URL}/api/oauth/outlook/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" (multi-tenant), "organizations", ou l'ID de tenant de l'entreprise.
MICROSOFT_TENANT_ID=common

# ─── Notifications e-mail (optionnel) ──────────────────────────────────────────
# Sans SMTP_HOST, les rappels restent visibles dans le fil in-app uniquement.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_FROM="Agenda familial <agenda@exemple.fr>"
