# ─── Serveur ───────────────────────────────────────────────────────────────────
PORT=3000
# URL publique de l'application. Détermine les redirect URI OAuth, les liens
# d'invitation, et l'activation du cookie sécurisé (dès qu'elle est en https).
APP_BASE_URL=http://localhost:3000
DATABASE_PATH=./data/familyboard.db

# Domaine servi par Caddy dans le déploiement Docker Compose.
DOMAIN=agenda.mondomaine.fr

# Nombre de proxys de confiance devant l'application (nginx/Caddy = 1, sinon 0).
# Par défaut : 1 si APP_BASE_URL est en https, 0 sinon.
#TRUST_PROXY=1

# Fuseau horaire par défaut du foyer (IANA). Sert au calcul des rappels.
DEFAULT_TIMEZONE=Europe/Paris
# Heure locale d'envoi des rappels J-7, J-1 et jour J (0-23).
REMINDER_HOUR=8

# ─── Planificateur ─────────────────────────────────────────────────────────────
# Intervalle de vérification des rappels à envoyer (ms).
SCHEDULER_INTERVAL_MS=60000
# Intervalle de synchronisation automatique des agendas liés (ms). 0 = désactivé.
SYNC_INTERVAL_MS=900000

# ─── Comptes et connexion ──────────────────────────────────────────────────────
# Qui peut ouvrir un compte :
#   invite    : uniquement via un lien d'invitation (la première connexion de
#               l'instance crée le foyer et en devient responsable) — recommandé ;
#   open      : chaque nouvel arrivant crée son propre foyer, isolé des autres ;
#   allowlist : seules les adresses listées dans ALLOWED_EMAILS peuvent entrer.
SIGNUP_MODE=invite
ALLOWED_EMAILS=

# Durée de validité d'une session (jours).
SESSION_TTL_DAYS=30

# ─── Google (connexion à l'application + agenda perso) ─────────────────────────
# Console Google Cloud > API & Services > Identifiants > ID client OAuth (Web).
# DEUX redirect URI à déclarer :
#   {APP_BASE_URL}/api/auth/google/callback    (connexion à l'application)
#   {APP_BASE_URL}/api/oauth/google/callback   (liaison de l'agenda Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Microsoft Graph / Outlook (compte pro) ────────────────────────────────────
# Portail Azure > Inscriptions d'applications. Redirect URI (Web) à déclarer :
# {APP_BASE_URL}/api/oauth/outlook/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" (multi-tenant), "organizations", ou l'ID de tenant de l'entreprise.
MICROSOFT_TENANT_ID=common

# ─── Notifications e-mail (optionnel) ──────────────────────────────────────────
# Sans SMTP_HOST, les rappels restent visibles dans le fil in-app uniquement.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_FROM="Agenda familial <agenda@exemple.fr>"
